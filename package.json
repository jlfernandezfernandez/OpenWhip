{
  "name": "openwhip",
  "desktopName": "com.openwhip.app.desktop",
  "version": "1.2.6",
  "description": "A fast, focused desktop whip for slow coding agents",
  "author": {
    "name": "OpenWhip contributors",
    "email": "jlfernandezfernandez@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "bin": {
    "openwhip": "bin/openwhip.js",
    "badclaude": "bin/openwhip.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlfernandezfernandez/OpenWhip.git"
  },
  "bugs": {
    "url": "https://github.com/jlfernandezfernandez/OpenWhip/issues"
  },
  "homepage": "https://github.com/jlfernandezfernandez/OpenWhip#readme",
  "files": [
    "main.js",
    "preload.js",
    "overlay.html",
    "sounds",
    "icon",
    "bin/openwhip.js",
    "bin/badclaude.js",
    "README.md"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "npm pack",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "check": "node --check main.js && node --check preload.js"
  },
  "build": {
    "appId": "com.openwhip.app",
    "productName": "OpenWhip",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist.noindex"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "sounds/**/*",
      "icon/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "icon/icon.png",
      "target": "nsis"
    },
    "linux": {
      "category": "Utility",
      "synopsis": "A fast desktop whip for slow coding agents",
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^43.5.1",
    "electron-builder": "^26.15.3"
  }
}
