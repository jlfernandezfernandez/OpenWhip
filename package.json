{
  "name": "openwhip",
  "version": "2.1.4",
  "private": true,
  "description": "A tiny menu-bar whip that types FASTER into your coding agent. Crack it, it types.",
  "author": {
    "name": "OpenWhip contributors",
    "email": "jlfernandezfernandez@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlfernandezfernandez/OpenWhip.git"
  },
  "bugs": {
    "url": "https://github.com/jlfernandezfernandez/OpenWhip/issues"
  },
  "homepage": "https://github.com/jlfernandezfernandez/OpenWhip#readme",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test",
    "check": "npm run lint && npm test",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.7.1",
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.openwhip.app",
    "productName": "OpenWhip",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist.noindex"
    },
    "publish": {
      "provider": "github",
      "owner": "jlfernandezfernandez",
      "repo": "OpenWhip"
    },
    "files": [
      "src/**/*",
      "sounds/**/*",
      "icon/**/*",
      "package.json",
      "!node_modules/koffi/{doc,lib,vendor}/**",
      "!node_modules/koffi/{cnoke.cjs,*.md,*.d.ts}"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "afterPack": "scripts/sign-mac.js",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "icon/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "category": "Utility",
      "icon": "icon/icon.png",
      "synopsis": "A tiny tray whip that tells your coding agent to hurry up",
      "files": [
        "!node_modules/koffi/**",
        "!node_modules/@koromix/**"
      ],
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
